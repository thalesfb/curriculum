---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import cvData from '../../data/cv.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projectOrder = [
  'github.com/thalesfb/ccw',
  'github.com/thalesfb/machine_learning',
  'github.com/thalesfb/library',
  'github.com/thalesfb/digital-image-processing',
  'github.com/thalesfb/AI',
  'Infraestrutura de comunicação industrial: implantação e integração de redes e protocolos para automação de processos',
  'Plataforma de Decisão Compartilhada Humano-Máquina para Processos Industriais',
];

const projects = projectOrder
  .map((identifier) => cvData.projects.find((p) => p.repo === identifier || p.name === identifier))
  .filter((p): p is (typeof cvData.projects)[number] => Boolean(p));

const iconByTechnology: Record<string, string> = {
  python: '/icons/python.svg',
  'scikit-learn': '/icons/scikitlearn.svg',
  tensorflow: '/icons/tensorflow.svg',
  'machine learning': '/icons/dlml.svg',
  java: '/icons/java.svg',
  'spring boot': '/icons/java.svg',
  mysql: '/icons/mysql.svg',
  'jpa/hibernate': '/icons/backend.svg',
  'spring data jpa': '/icons/backend.svg',
  hibernate: '/icons/backend.svg',
  shell: '/icons/shell.svg',
  linux: '/icons/linux.svg',
  nginx: '/icons/nginx.svg',
  docker: '/icons/docker.svg',
  ansible: '/icons/devops.svg',
  c: '/icons/c-lang.svg',
  algorithms: '/icons/algorithms.svg',
  ci: '/icons/devops.svg',
  'learning analytics': '/icons/data-analysis.svg',
};

const iconFor = (technology: string) => iconByTechnology[technology.toLowerCase()];
const repositoryUrl = (repo: string) => repo.startsWith('http') ? repo : `https://${repo}`;
---

<section class="bg-bg-card py-20 max-md:py-12" id="projects">
  <div class="mx-auto max-w-[1440px] px-20 max-xl:px-12 max-md:px-6">
    <h2 class="mb-12 text-center font-display text-4xl font-semibold text-text-primary max-md:text-3xl max-md:mb-8">{t('section.projects')}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {projects.map((project) => (
        <article class="project-card rounded-xl border border-brand-green bg-bg-card p-8 flex flex-col gap-4 max-md:p-6 shadow-sm">
          <h3 class="font-display text-xl font-semibold text-text-primary leading-snug">
            {project.nameByLanguage?.[lang as 'pt' | 'en' | 'es'] ?? project.name}
          </h3>
          <p class="flex-1 text-text-secondary leading-relaxed">
            {project.description[lang as 'pt' | 'en' | 'es']}
          </p>
          {project.technologies && project.technologies.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {project.technologies.map((technology) => {
                const icon = iconFor(technology);
                return (
                  <span class="inline-flex items-center gap-1.5 rounded-md border border-text-primary bg-bg-section-alt px-3 py-1.5 font-code text-xs font-medium uppercase tracking-wider text-text-primary">
                    {icon && (
                      <span
                        class="inline-block h-3.5 w-3.5 shrink-0 bg-brand-green"
                        style={`-webkit-mask: url(${icon}) no-repeat center; mask: url(${icon}) no-repeat center; -webkit-mask-size: contain; mask-size: contain;`}
                      ></span>
                    )}
                    {technology}
                  </span>
                );
              })}
            </div>
          )}
          {project.repo && (
            <a
              class="mt-auto inline-flex w-fit items-center gap-2 text-sm font-medium text-brand-green hover:underline"
              href={repositoryUrl(project.repo)}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t('projects.repository')}
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
