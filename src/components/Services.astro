---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import cvData from '../../data/cv.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface ServiceEntry {
  id: string;
  icon: string;
  title: Record<string, string>;
  description: Record<string, string>;
}

const services = (cvData.services ?? []) as ServiceEntry[];
---

<section class="bg-bg-section-alt py-20 max-md:py-12" id="services">
  <div class="mx-auto max-w-[1440px] px-20 max-xl:px-12 max-md:px-6">
    <h2 class="mb-12 text-center font-display text-4xl font-semibold text-text-primary max-md:text-3xl max-md:mb-8">{t('section.services')}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {services.map((s) => (
        <article class="rounded-xl border border-brand-green bg-bg-card p-10 flex flex-col items-center text-center gap-3 max-md:p-8 shadow-sm">
          <img src={s.icon} alt="" width="48" height="48" class="mb-2">
          <h3 class="font-display text-xl font-semibold text-text-primary leading-snug">{s.title[lang as 'pt' | 'en' | 'es']}</h3>
          <p class="text-text-secondary leading-relaxed">{s.description[lang as 'pt' | 'en' | 'es']}</p>
        </article>
      ))}
    </div>
  </div>
</section>
