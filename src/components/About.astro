---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import cvData from '../../data/cv.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localized = (value: Record<string, string> | undefined) => value?.[lang] ?? '';
const summaries = cvData.summary as Record<string, Record<string, string>>;
const activeRole = 'data-engineer';
const activeSummary = summaries[activeRole]?.[lang] ?? '';
const logoBySource: Record<string, string> = {
  'Instituto Federal Catarinense': '/logos/ifc.svg',
  SENAI: '/logos/senai.svg',
  Alura: '/logos/alura.svg',
  'Red Hat': '/logos/redhat.svg',
  'AWS Academy': '/logos/aws.svg',
  'Escola de Educação Básica Mater Salvatoris': '/logos/mater-salvatoris.webp',
};
const monthNames = {
  pt: ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho', 'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'],
  en: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
  es: ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'],
};
const monthYear = (value: string) => {
  const month = monthNames[lang][Number(value.slice(5, 7)) - 1];
  return lang === 'en' ? month + ' ' + value.slice(0, 4) : month + ' de ' + value.slice(0, 4);
};
const formatPeriod = (period: { start: string; end: string }) => period.start.slice(0, 7) === period.end.slice(0, 7)
  ? monthYear(period.start)
  : monthYear(period.start) + '–' + monthYear(period.end);
const educationItems = cvData.education.map((entry) => ({
  title: localized(entry.degree),
  source: entry.institution,
  logo: logoBySource[entry.institution],
  period: entry.period
    ? entry.period.start.slice(0, 4) === entry.period.end.slice(0, 4)
      ? entry.period.start.slice(0, 4)
      : entry.period.start.slice(0, 4) + '–' + entry.period.end.slice(0, 4)
    : '',
}));
const missingProviders = ['Não informado', 'Not specified', 'No especificado'];
const allCertificationItems = cvData.certifications
  .map((entry) => {
    const provider = localized(entry.providerByLanguage) || entry.provider || '';
    const source = missingProviders.includes(provider) ? '' : provider;
    return {
      title: localized(entry.name),
      source,
      logo: entry.name.pt.startsWith('Latinoware')
        ? '/logos/latinoware.webp'
        : entry.provider ? logoBySource[entry.provider] : undefined,
      logoAlt: entry.name.pt.startsWith('Latinoware') ? 'Latinoware' : source,
      period: entry.period ? formatPeriod(entry.period) : entry.date?.slice(0, 4) ?? '',
      date: entry.period?.end ?? entry.date ?? '',
      pending: entry.status === 'in-progress',
      isAluraGroup: entry.provider === 'Alura' && Array.isArray(entry.courses),
      hours: entry.hours,
      hoursYear: entry.hoursYear,
      editions: localized(entry.editions),
      courses: entry.courses ?? [],
      credentialUrl: entry.credentialUrl,
    };
  });
const aluraItems = allCertificationItems.filter((item) => item.isAluraGroup);
const aluraHours = aluraItems.reduce((total, item) => total + (item.hours ?? 0), 0);
const certificationItems = allCertificationItems
  .filter((item) => !item.isAluraGroup)
  .sort((a, b) => Number(b.pending) - Number(a.pending) || b.date.localeCompare(a.date));
---

<section class="bg-bg-card py-20 max-md:py-12" id="about">
  <div class="mx-auto max-w-[1440px] px-20 max-xl:px-12 max-md:px-6">
    <h2 class="mb-12 text-center font-display text-4xl font-semibold text-text-primary max-md:text-3xl max-md:mb-8">{t('section.about')}</h2>

    <div data-about-overview class="grid grid-cols-1 items-start gap-x-16 gap-y-12 max-md:gap-y-10 xl:grid-cols-[3fr_2fr]">
      <div class="text-text-secondary leading-relaxed">
        <p id="about-summary">{activeSummary}</p>
      </div>

      <div>
        <h3 class="mb-6 font-display text-xl font-semibold text-text-primary">{t('about.quickdata')}</h3>
        <dl class="flex flex-col gap-5">
          <div>
            <dt class="font-bold text-text-primary">{t('about.focus')}</dt>
            <dd class="text-text-secondary">{t('about.focus.value')}</dd>
          </div>
          <div>
            <dt class="font-bold text-text-primary">{t('about.methodology')}</dt>
            <dd class="text-text-secondary">{t('about.methodology.value')}</dd>
          </div>
          <div>
            <dt class="font-bold text-text-primary">{t('about.status')}</dt>
            <dd class="font-medium text-brand-green">{t('about.status.value')}</dd>
          </div>
        </dl>
      </div>

    </div>

    <div data-about-learning class="mt-12">
      <section id="education" aria-labelledby="about-formal-education-heading">
        <h3 id="about-formal-education-heading" class="mb-4 font-display text-lg font-semibold text-text-primary">{t('about.education.formal')}</h3>
        <ul data-education-grid class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
          {educationItems.map((item) => (
            <li data-education-item data-education-period={item.period} class="flex items-center gap-3 text-text-secondary">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-bg-page shadow-sm">
                {item.logo ? (
                  <img src={item.logo} alt={item.source} width="32" height="32" class="max-h-8 max-w-8 object-contain" loading="lazy">
                ) : (
                  <svg aria-hidden="true" class="h-5 w-5 text-text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" />
                  </svg>
                )}
              </div>
              <span class="min-w-0 flex-1">
                <span class="block">{item.title}</span>
                {(item.source || item.period) && <span class="block text-xs text-text-secondary/80">{[item.source, item.period].filter(Boolean).join(' · ')}</span>}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-8" aria-labelledby="about-certifications-heading">
        <h3 id="about-certifications-heading" class="mb-4 font-display text-lg font-semibold text-text-primary">{t('about.certifications')}</h3>
        <ul data-certifications-grid class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
          {aluraItems.length > 0 && (
            <li data-certification-item data-alura-block class="col-span-full rounded-xl border border-border-line bg-bg-page p-4 text-text-secondary">
              <h4 class="mb-3 font-medium text-text-primary">Alura · {aluraHours}h</h4>
              <ul data-alura-groups class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                {aluraItems.map((item) => (
                  <li data-alura-group class="rounded-xl border border-border-line bg-bg-card p-4 text-text-secondary">
                    <details class="group">
                      <summary class="flex cursor-pointer list-none items-center gap-3">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-bg-card shadow-sm">
                          <img src={item.logo} alt="" width="32" height="32" class="max-h-8 max-w-8 object-contain" loading="lazy">
                        </span>
                        <span class="min-w-0 flex-1">
                          <span class="block font-medium text-text-primary">{item.title}</span>
                          <span class="block text-xs text-text-secondary/80">{item.hours}h{item.period && ' · ' + item.period}</span>
                        </span>
                        <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-text-secondary transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="m6 9 6 6 6-6" />
                        </svg>
                      </summary>
                      {item.courses.length > 0 && (
                        <ul class="mt-3 space-y-2 pl-1 text-sm text-text-secondary">
                          {item.courses.map((course) => (
                            <li
                              data-alura-course
                              data-course-hours={course.hours}
                              data-course-period={course.period ? `${course.period.start}–${course.period.end}` : undefined}
                              class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1"
                            >
                              <span>{localized(course)}</span>
                              <span class="shrink-0 text-xs text-text-secondary/80">
                                {course.hours}h{course.period && ` · ${formatPeriod(course.period)}`}
                              </span>
                            </li>
                          ))}
                        </ul>
                      )}
                      {item.credentialUrl && <a class="mt-3 inline-block text-sm font-medium text-brand-green underline decoration-current/40 underline-offset-2" href={item.credentialUrl} target="_blank" rel="noopener noreferrer">{t('about.fullCertificate')}</a>}
                    </details>
                  </li>
                ))}
              </ul>
            </li>
          )}
          {certificationItems.map((item) => (
            <li data-certification-item class="flex items-center gap-3 text-text-secondary">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-bg-page shadow-sm">
                {item.logo ? (
                  <img src={item.logo} alt={item.logoAlt} width="32" height="32" class="max-h-8 max-w-8 object-contain" loading="lazy">
                ) : (
                  <svg aria-hidden="true" class="h-5 w-5 text-text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" />
                  </svg>
                )}
              </div>
              <span class="min-w-0 flex-1">
                <span class="block">{item.title}</span>
                {(item.source || item.hours != null || item.editions) && (
                  <span class="block text-xs text-text-secondary/80">
                    {[item.source, item.hours == null ? '' : `${item.hours}h${item.hoursYear ? ` (${item.hoursYear})` : ''}`, item.editions || item.period].filter(Boolean).join(' · ')}
                  </span>
                )}
              </span>
              {item.pending && <span class="shrink-0 whitespace-nowrap rounded-full bg-brand-green/15 px-2 py-0.5 text-xs font-medium text-brand-green">{t('about.pending')}</span>}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</section>
