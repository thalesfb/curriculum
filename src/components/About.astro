---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import cvData from '../../data/cv.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localized = (value: Record<string, string> | undefined) => value?.[lang] ?? '';
const summaries = cvData.summary as Record<string, Record<string, string>>;
const activeRole = 'data-engineer';
const activeSummary = summaries[activeRole]?.[lang] ?? '';
const logoBySource: Record<string, string> = {
  'Instituto Federal Catarinense': '/logos/ifc.svg',
  SENAI: '/logos/senai.svg',
  Alura: '/logos/alura.svg',
  'Red Hat': '/logos/redhat.svg',
  'AWS Academy': '/logos/aws.svg',
};
const currentMonth = new Date().toISOString().slice(0, 7);
const educationItems = cvData.education.map((entry) => ({
  title: localized(entry.degree),
  source: entry.institution,
  logo: logoBySource[entry.institution],
  period: entry.period ? `${entry.period.start.slice(0, 4)}–${entry.period.end.slice(0, 4)}` : '',
  pending: Boolean(entry.period?.end && entry.period.end >= currentMonth),
}));
const certificationItems = cvData.certifications.map((entry) => {
  const source = localized(entry.providerByLanguage) || entry.provider || '';
  return {
    title: localized(entry.name),
    source,
    logo: entry.provider ? logoBySource[entry.provider] : undefined,
    period: entry.date?.slice(0, 4) ?? '',
    pending: entry.status === 'in-progress',
  };
});
---

<section class="bg-bg-card py-20 max-md:py-12" id="about" data-role-summaries={JSON.stringify(summaries)}>
  <div class="mx-auto max-w-[1440px] px-20 max-xl:px-12 max-md:px-6">
    <h2 class="mb-12 text-center font-display text-4xl font-semibold text-text-primary max-md:text-3xl max-md:mb-8">{t('section.about')}</h2>

    <div data-about-overview class="grid grid-cols-1 items-start gap-x-16 gap-y-12 max-md:gap-y-10 xl:grid-cols-[3fr_2fr]">
      <div class="text-text-secondary leading-relaxed">
        <p id="about-summary">{activeSummary}</p>
      </div>

      <div>
        <h3 class="mb-6 font-display text-xl font-semibold text-text-primary">{t('about.quickdata')}</h3>
        <dl class="flex flex-col gap-5">
          <div>
            <dt class="font-bold text-text-primary">{t('about.focus')}</dt>
            <dd class="text-text-secondary">{t('about.focus.value')}</dd>
          </div>
          <div>
            <dt class="font-bold text-text-primary">{t('about.methodology')}</dt>
            <dd class="text-text-secondary">{t('about.methodology.value')}</dd>
          </div>
          <div>
            <dt class="font-bold text-text-primary">{t('about.status')}</dt>
            <dd class="font-medium text-brand-green">{t('about.status.value')}</dd>
          </div>
        </dl>
      </div>

    </div>

    <div data-about-learning class="mt-12">
      <h3 class="mb-6 font-display text-xl font-semibold text-text-primary">{t('about.education')}</h3>

      <section aria-labelledby="about-formal-education-heading">
        <h4 id="about-formal-education-heading" class="mb-4 font-display text-lg font-semibold text-text-primary">{t('about.education.formal')}</h4>
        <ul data-education-grid class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
          {educationItems.map((item) => {
            const fallback = (item.source || item.title).slice(0, 2).toUpperCase();
            return (
              <li class="flex items-center gap-3 text-text-secondary">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-bg-page shadow-sm">
                  {item.logo ? (
                    <img src={item.logo} alt={item.source} width="32" height="32" class="max-h-8 max-w-8 object-contain" loading="lazy">
                  ) : (
                    <span class="text-[10px] font-bold text-text-secondary" aria-label={item.source || item.title}>{fallback}</span>
                  )}
                </div>
                <span class="min-w-0 flex-1">
                  <span class="block">{item.title}</span>
                  {(item.source || item.period) && <span class="block text-xs text-text-secondary/80">{[item.source, item.period].filter(Boolean).join(' · ')}</span>}
                </span>
                {item.pending && <span class="shrink-0 whitespace-nowrap rounded-full bg-brand-green/15 px-2 py-0.5 text-xs font-medium text-brand-green">{t('about.pending')}</span>}
              </li>
            );
          })}
        </ul>
      </section>

      <section class="mt-8" aria-labelledby="about-certifications-heading">
        <h4 id="about-certifications-heading" class="mb-4 font-display text-lg font-semibold text-text-primary">{t('about.certifications')}</h4>
        <ul data-certifications-grid class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
          {certificationItems.map((item) => {
            const fallback = (item.source || item.title).slice(0, 2).toUpperCase();
            return (
              <li class="flex items-center gap-3 text-text-secondary">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-bg-page shadow-sm">
                  {item.logo ? (
                    <img src={item.logo} alt={item.source} width="32" height="32" class="max-h-8 max-w-8 object-contain" loading="lazy">
                  ) : (
                    <span class="text-[10px] font-bold text-text-secondary" aria-label={item.source || item.title}>{fallback}</span>
                  )}
                </div>
                <span class="min-w-0 flex-1">
                  <span class="block">{item.title}</span>
                  {(item.source || item.period) && <span class="block text-xs text-text-secondary/80">{[item.source, item.period].filter(Boolean).join(' · ')}</span>}
                </span>
                {item.pending && <span class="shrink-0 whitespace-nowrap rounded-full bg-brand-green/15 px-2 py-0.5 text-xs font-medium text-brand-green">{t('about.pending')}</span>}
              </li>
            );
          })}
        </ul>
      </section>
    </div>
  </div>
</section>

<script>
  const about = document.getElementById('about');
  const summary = document.getElementById('about-summary');
  const roleSelector = document.getElementById('role-selector') as HTMLSelectElement | null;

  if (about && summary) {
    const summaries = JSON.parse(about.dataset.roleSummaries || '{}') as Record<string, Record<string, string>>;
    const updateSummary = (role: string) => {
      if (summaries[role]?.[document.documentElement.lang.split('-')[0]]) {
        summary.textContent = summaries[role][document.documentElement.lang.split('-')[0]];
      }
    };
    updateSummary(roleSelector?.value || 'data-engineer');
    document.addEventListener('cv:role-change', (event) => {
      const role = (event as CustomEvent<{ role: string }>).detail?.role;
      if (role) updateSummary(role);
    });
  }
</script>
